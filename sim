<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ela disse SIM</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      min-height: 100vh;
      overflow-x: hidden;
      background:
        radial-gradient(circle at top, rgba(255,255,255,0.35), transparent 28%),
        linear-gradient(180deg, #ff5fb7 0%, #ff9cd2 22%, #ffd9f0 44%, #fff7b3 68%, #bff3ff 100%);
      text-align: center;
      color: #7a0047;
      position: relative;
    }

    .wrap {
      position: relative;
      z-index: 2;
      padding: 28px 18px 50px;
    }

    h1 {
      font-size: clamp(2.2rem, 5vw, 4.5rem);
      color: #ff1f78;
      text-shadow: 0 4px 14px rgba(255,255,255,0.8);
      margin-top: 20px;
    }

    p {
      font-size: clamp(1rem, 2.2vw, 1.4rem);
      margin-top: 12px;
      margin-bottom: 24px;
    }

    .grid {
      max-width: 1200px;
      margin: 0 auto;
      padding: 10px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .card {
      background: rgba(255,255,255,0.55);
      border-radius: 18px;
      padding: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      backdrop-filter: blur(4px);
    }

    .card img {
      width: 100%;
      display: block;
      border-radius: 14px;
    }

    .fundo {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      overflow: hidden;
    }

    .heart {
      position: absolute;
      width: 22px;
      height: 22px;
      background: #ff2d7d;
      transform: rotate(45deg);
      animation: subir linear infinite;
      opacity: 0.35;
      border-radius: 4px;
    }

    .heart::before,
    .heart::after {
      content: "";
      position: absolute;
      width: 22px;
      height: 22px;
      background: #ff2d7d;
      border-radius: 50%;
    }

    .heart::before {
      left: -11px;
      top: 0;
    }

    .heart::after {
      left: 0;
      top: -11px;
    }

    @keyframes subir {
      from { transform: translateY(110vh) rotate(45deg); }
      to { transform: translateY(-140px) rotate(45deg); }
    }
  </style>
</head>
<body>
  <div class="fundo" id="fundo"></div>

  <div class="wrap">
    <h1>Ela disse SIM</h1>
    <p>Agora há ursos carinhosos, arco-íris, corações, felicidade e muito amor.</p>

    <div class="grid">
      <div class="card">
        <img src="https://media.giphy.com/media/l0HlOvJ7yaacpuSas/giphy.gif" alt="Urso carinhoso">
      </div>
      <div class="card">
        <img src="https://media.giphy.com/media/3oriO0OEd9QIDdllqo/giphy.gif" alt="Urso carinhoso">
      </div>
      <div class="card">
        <img src="https://media.giphy.com/media/ICOgUNjpvO0PC/giphy.gif" alt="Arco-íris">
      </div>
      <div class="card">
        <img src="https://media.giphy.com/media/5GoVLqeAOo6PK/giphy.gif" alt="Corações e amor">
      </div>
    </div>
  </div>

  <script>
    const fundo = document.getElementById("fundo");

    for (let i = 0; i < 40; i++) {
      const heart = document.createElement("div");
      heart.className = "heart";
      heart.style.left = Math.random() * 100 + "vw";
      heart.style.bottom = "-40px";
      heart.style.animationDuration = (6 + Math.random() * 8) + "s";
      heart.style.animationDelay = (Math.random() * 6) + "s";
      heart.style.transform = `translateY(0) rotate(45deg) scale(${0.6 + Math.random() * 1.4})`;
      fundo.appendChild(heart);
    }
  </script>
</body>
</html>
