<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Uma Pergunta Importante</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: linear-gradient(135deg, #ffb3d9, #ffe0ef);
      position: relative;
    }

    .popup {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      background: white;
      padding: 32px;
      border-radius: 20px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
      min-width: 320px;
      max-width: 90vw;
      z-index: 10;
    }

    h1 {
      color: #ff4f9a;
      margin-bottom: 18px;
      font-size: 1.8rem;
    }

    .buttons {
      display: flex;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    button {
      border: none;
      padding: 12px 28px;
      border-radius: 12px;
      font-size: 18px;
      cursor: pointer;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    button:hover {
      transform: scale(1.06);
    }

    .sim {
      background: #35b24a;
      color: white;
    }

    .nao {
      background: #ff4d4d;
      color: white;
    }

    .erro {
      margin-top: 14px;
      color: #e60000;
      font-weight: bold;
      display: none;
      min-height: 24px;
    }
  </style>
</head>
<body>
  <div class="popup" id="popup">
    <h1>Queres namorar comigo?</h1>
    <div class="buttons">
      <button class="sim" onclick="aceitar()">Sim</button>
      <button class="nao" onclick="recusar()">Não</button>
    </div>
    <div class="erro" id="erro">Resposta errada</div>
  </div>

  <script>
    function aceitar() {
      // Usamos o link direto para o GitHub não dar erro 404
      window.location.href = "https://bosini47.github.io/Surpresa/sim.html";
    }

    function recusar() {
      const popup = document.getElementById("popup");
      const erro = document.getElementById("erro");
      erro.style.display = "block";

      const larguraJanela = window.innerWidth;
      const alturaJanela = window.innerHeight;
      const larguraPopup = popup.offsetWidth;
      const alturaPopup = popup.offsetHeight;

      const maxX = Math.max(0, larguraJanela - larguraPopup);
      const maxY = Math.max(0, alturaJanela - alturaPopup);

      const x = Math.random() * maxX;
      const y = Math.random() * maxY;

      popup.style.left = x + "px";
      popup.style.top = y + "px";
      popup.style.transform = "none";
    }
  </script>
</body>
</html>
