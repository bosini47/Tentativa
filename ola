<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Uma Pergunta Importante ❤️</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    width:100vw;
    height:100vh;
    overflow:hidden;
    background:linear-gradient(135deg,#ff9ecf,#ffd6ea);
    position:relative;
}

.popup{
    position:absolute;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    background:white;
    padding:35px;
    border-radius:20px;
    text-align:center;
    box-shadow:0 10px 30px rgba(0,0,0,.2);
    min-width:350px;
}

h1{
    color:#ff4f9a;
    margin-bottom:20px;
}

.buttons{
    display:flex;
    justify-content:center;
    gap:15px;
}

button{
    border:none;
    padding:12px 30px;
    border-radius:12px;
    font-size:18px;
    cursor:pointer;
    transition:.2s;
}

.sim{
    background:#4CAF50;
    color:white;
}

.nao{
    background:#ff4d4d;
    color:white;
}

button:hover{
    transform:scale(1.08);
}

.erro{
    margin-top:15px;
    color:red;
    font-weight:bold;
    display:none;
}
</style>
</head>

<body>

<div class="popup" id="popup">
    <h1>Queres namorar comigo?</h1>

    <div class="buttons">
        <button class="sim" onclick="aceitar()">Sim</button>
        <button class="nao" onclick="recusar()">Não</button>
    </div>

    <div class="erro" id="erro">
        Resposta errada
    </div>
</div>

<script>

function aceitar(){
    window.location.href="sim.html";
}

function recusar(){

    document.getElementById("erro").style.display="block";

    const popup=document.getElementById("popup");

    const larguraJanela=window.innerWidth;
    const alturaJanela=window.innerHeight;

    const larguraPopup=popup.offsetWidth;
    const alturaPopup=popup.offsetHeight;

    const x=Math.random()*(larguraJanela-larguraPopup);
    const y=Math.random()*(alturaJanela-alturaPopup);

    popup.style.left=x+"px";
    popup.style.top=y+"px";
    popup.style.transform="none";
}

</script>

</body>
</html>
